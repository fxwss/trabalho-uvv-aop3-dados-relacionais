{
  "name": "@precos/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "API REST que executa as consultas do item II.d sobre o banco da AOP2",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --external:pg --external:hono --external:@hono/node-server --external:exceljs",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@precos/shared": "*",
    "exceljs": "^4.4.0",
    "hono": "^4.13.8",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}