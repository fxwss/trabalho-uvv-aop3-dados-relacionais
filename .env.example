# Porta publica do site (nginx). Troque se a porta 8080 ja estiver em uso.
PORTA_SITE=8080

# Porta do Postgres de desenvolvimento (npm run banco:dev) exposta no host.
PORTA_BANCO_LOCAL=5433

# Credenciais do Postgres. O banco nao fica exposto para a internet.
#
# ATENCAO: a senha e aplicada apenas na CRIACAO do volume do banco. Se voce trocar
# aqui depois do primeiro "npm run compose:up", a API vai falhar com
# "password authentication failed for user precos" e sera preciso recriar o volume:
#   npm run compose:reset
POSTGRES_DB=combustivel
POSTGRES_USER=precos
POSTGRES_PASSWORD=precos

# Origem liberada no CORS da API. Em producao, o proprio nginx serve o site e
# faz proxy de /api, entao pode manter o valor restritivo abaixo.
CORS_ORIGIN=http://localhost:8080
